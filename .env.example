# --- Postgres ---
# 本机开发用 docker-compose 起 Postgres，端口用非标准 55432 避让，
# 避免与开发机上其他项目的 Postgres(5432) 冲突（团队规则 TEA-40）。
DATABASE_URL="postgresql://x2t:x2t@localhost:55432/x2t?schema=public"

# --- 应用公网地址 ---
# 反向代理（Zeabur 等）后用它拼绝对链接（magic-link / 登录跳转 / RSS 自链）。
# 不设则回退到 X-Forwarded-Host / 请求 origin。生产务必设为对外域名。
APP_URL=

# --- 前端分析 (Google Analytics) ---
# gtag.js measurement id；仅生产环境注入。不填则用代码内默认 G-6JQKNSVGXM。
NEXT_PUBLIC_GA_ID=G-6JQKNSVGXM
# Google Search Console 站点验证 token(HTML 标签法的 content 值);配后自动注入 <meta name=google-site-verification>。
GOOGLE_SITE_VERIFICATION=

# --- 限流后端(可选) ---
# 配了就用 Redis 固定窗口(跨实例/重启共享);留空则进程内内存兜底(单容器够用)。
# Zeabur 已有 Redis 服务,填其内部连接串即可激活。
REDIS_URL=

# --- 抓取 / 轮询 ---
# 近实时 = 几分钟级轮询（毫秒）。默认 3 分钟。
POLL_INTERVAL_MS=180000
# Worker 每轮分析的批大小（pnpm worker）。
ANALYZE_BATCH=20
# 过期外部数据缓存 GC 间隔(ms)，worker 内节流执行。默认 1 小时。
CACHE_GC_INTERVAL_MS=3600000

# --- 图谱/共识 查询规模化(防数据增长后全表扫描) ---
# 图谱只看近 N 天、进程内缓存 N 毫秒、单次最多 N 条边(payload 上限)。
GRAPH_WINDOW_DAYS=90
GRAPH_MEMO_MS=60000
GRAPH_MAX_EDGES=600
# 共识/辩论查询的硬扫描窗口(天):超过此窗口的旧立场不计入当前共识。
CONSENSUS_SCAN_DAYS=730

# --- 自建 RSSHub（统一抓取网关：X / Reddit / StockTwits 等）---
# sourceConfig.feedPath 经此解析（见 src/lib/connectors/rss.ts）。
# 本机：docker compose up rsshub 后用 http://localhost:51200
# 容器内：http://rsshub:1200（compose 已注入）
RSSHUB_BASE_URL=http://localhost:51200
# X 抓取需 RSSHub 配置访问凭据（逗号分隔可多账号），注入到 RSSHub 容器。
# 配置方法见 RSSHub 官方文档；注意:自动化抓取可能受第三方平台服务条款约束,请自行评估合规与账号风险。
TWITTER_AUTH_TOKEN=

# --- web-push (VAPID) ---
# 生成：pnpm exec web-push generate-vapid-keys --json
VAPID_SUBJECT=mailto:admin@x2t.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- LLM (OpenAI 兼容：OpenAI 官方 / DeepSeek / 其他) ---
# 不填 LLM_API_KEY → 用 mock 分析（管道可无 key 跑通）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# DeepSeek 示例：LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-v4-pro（质量优先）或 deepseek-v4-flash（便宜高量）
#   注：旧名 deepseek-chat / deepseek-reasoner 将于 2026-07-24 停用
# 翻译用更便宜的 flash 模型（默认 deepseek-v4-flash），与分析 agent 解耦
TRANSLATE_MODEL=deepseek-v4-flash
# 单次 LLM 调用超时(ms)，防 worker 被卡死请求拖住
LLM_TIMEOUT_MS=60000
# analyzePending 并发度(1-8)，吞吐与限流的折中
ANALYZE_CONCURRENCY=3
# 单次 LLM 输出 token 上限(防异常长输出烧额度)
LLM_MAX_TOKENS=4000
# 当日分析帖数上限(成本闸,0=不限;防 backfill/批量重分析烧爆额度)
ANALYZE_DAILY_CAP=0
# 单帖分析失败的最大重试次数(瞬时失败指数退避重试,达上限才终态)
ANALYZE_MAX_ATTEMPTS=3
# 入场 bar 距发帖最大容差(天):超过视为左删失剔除,防 call 早于价格窗口被吸附到最旧 bar(统计 stataudit-1)
MAX_ENTRY_GAP_DAYS=10
# 抓取并发池(1-8) / 价格历史窗口 / 价格回填单轮最多标的数 / SPY 基准进程内缓存(ms)
INGEST_CONCURRENCY=5
PRICE_RANGE=2y
PRICE_BACKFILL_MAX=3000
SPY_MEMO_MS=60000
# digest 每日 UTC 此小时后首个 tick 发(默认美东早晨) / Delivery 记录保留天数(GC)
DIGEST_HOUR_UTC=13
DELIVERY_RETENTION_DAYS=30

# --- 行情数据 provider（Finnhub 免费档；不填用 mock。行情主源，其它源只做补充） ---
FINNHUB_API_KEY=
MARKETDATA_TTL_MS=600000
# 外部数据 HTTP 调用超时(ms)，AV/FMP/Finnhub 共用。
MARKETDATA_HTTP_TIMEOUT_MS=10000
# --- 语义新闻增强（Exa，有免费额度；不填则自动降级，仅用 Finnhub/mock 新闻） ---
EXA_API_KEY=
EXA_TIMEOUT_MS=8000
# --- 新闻情绪（Alpha Vantage NEWS_SENTIMENT，免费 25/day；不填则不输出情绪维度） ---
# 额度极紧 → 按天缓存。SENTIMENT_TTL_MS 默认 12h。
ALPHAVANTAGE_API_KEY=
SENTIMENT_TTL_MS=43200000
# --- 事件日历（财报日） ---
# 事件源链:Finnhub earnings(免费,逐标的)→ Nasdaq 免费日历(补缺)→ FMP(降级)。
# Nasdaq:无 key,EVENTS_NASDAQ=1 开启;worker 每日拉未来 N 天日历聚成 symbol→财报日 map。
EVENTS_NASDAQ=0
NASDAQ_EARNINGS_DAYS=35
# FMP 免费档【不含】财报日历(付费端点),仅作最后降级;一般无需配。
FMP_API_KEY=
EVENTS_TTL_MS=43200000

# --- 账号 / 邮件 (M5) ---
# 会话 cookie 签名密钥（生产务必改成随机值）。生成：openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-secret

# 发件人地址（CF / SMTP 共用）。必须是【已验证域名】地址，如 noreply@actionow.ai
EMAIL_FROM=

# 邮件后端优先级：Cloudflare Email Service(REST) > SMTP > 控制台。
# A) Cloudflare Email Service（推荐；需先在 CF 后台 onboard 发信域名并加 DNS）
CF_EMAIL_ACCOUNT_ID=
CF_EMAIL_API_TOKEN=
# B) 或传统 SMTP（Resend/Brevo/SES 等）；不配 SMTP_HOST 且未配 CF 则邮件打到控制台（dev 可用）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=X2T <noreply@x2t.local>

# --- 每日摘要（Worker 内置可选；默认关，建议用独立 cron 跑 pnpm digest）---
WORKER_RUN_DIGEST=false
DIGEST_INTERVAL_MS=86400000

# --- 推送通知治理（借鉴 PanWatch；防刷屏）---
NEWPOST_DAILY_CAP=12             # 每订阅每天「新帖」推送上限
FLIP_DAILY_CAP=6                 # 每订阅每天「立场转向」推送上限
PUSH_COOLDOWN_MINUTES=0          # 两次推送最小间隔（分钟），0=关
QUIET_HOURS_UTC=                 # 静音时段（UTC，如 22-7），留空=不静音
ALERT_COOLDOWN_MS=21600000       # 同一告警规则命中后冷却（默认 6h）

# --- 价格回填 / 博主战绩（Yahoo/Stooq 免费日线 → PriceDaily → 跑赢大盘回测）---
PRICE_BACKFILL_INTERVAL_MS=86400000  # Worker 价格回填间隔（默认每天）
PRICE_TIMEOUT_MS=10000               # 单次价格抓取超时
WINRATE_SHOW_SAMPLES=10              # 战绩满几条已结算样本才显示比率
WINRATE_CONFIDENT_SAMPLES=30        # 低于此样本数附「样本少」提示

# --- 管理后台 ---
# 管理员邮箱（逗号分隔）。留空时任何登录用户都是管理员（仅便于本机；生产务必设置）。
ADMIN_EMAILS=
