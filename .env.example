# --- Postgres ---
# 本机开发用 docker-compose 起 Postgres，端口用非标准 55432 避让，
# 避免与开发机上其他项目的 Postgres(5432) 冲突（团队规则 TEA-40）。
DATABASE_URL="postgresql://x2t:x2t@localhost:55432/x2t?schema=public"

# --- 抓取 / 轮询 ---
# 近实时 = 几分钟级轮询（毫秒）。默认 3 分钟。
POLL_INTERVAL_MS=180000
# Worker 每轮分析的批大小（pnpm worker）。
ANALYZE_BATCH=20

# --- 自建 RSSHub（统一抓取网关：X / Reddit / StockTwits 等）---
# sourceConfig.feedPath 经此解析（见 src/lib/connectors/rss.ts）。
# 本机：docker compose up rsshub 后用 http://localhost:51200
# 容器内：http://rsshub:1200（compose 已注入）
RSSHUB_BASE_URL=http://localhost:51200
# X 抓取需登录 cookie 的 auth_token（逗号分隔可多账号），注入到 RSSHub 容器。
# 取法：浏览器登录 x.com → 开发者工具 Application/Cookies → 复制 auth_token 值。
TWITTER_AUTH_TOKEN=

# --- web-push (VAPID) ---
# 生成：pnpm exec web-push generate-vapid-keys --json
VAPID_SUBJECT=mailto:admin@x2t.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- LLM (OpenAI 兼容：OpenAI 官方 / DeepSeek / 其他) ---
# 不填 LLM_API_KEY → 用 mock 分析（管道可无 key 跑通）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# DeepSeek 示例：LLM_BASE_URL=https://api.deepseek.com   LLM_MODEL=deepseek-chat

# --- 行情数据 provider（Finnhub 免费档；不填用 mock） ---
FINNHUB_API_KEY=
MARKETDATA_TTL_MS=600000

# --- 账号 / 邮件 (M5) ---
# 会话 cookie 签名密钥（生产务必改成随机值）。生成：openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-secret
# 邮件（magic-link 登录 + 摘要）；不配 SMTP_HOST 则邮件打到控制台（dev 可用）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=X2T <noreply@x2t.local>

# --- 每日摘要（Worker 内置可选；默认关，建议用独立 cron 跑 pnpm digest）---
WORKER_RUN_DIGEST=false
DIGEST_INTERVAL_MS=86400000

# --- 管理后台 ---
# 管理员邮箱（逗号分隔）。留空时任何登录用户都是管理员（仅便于本机；生产务必设置）。
ADMIN_EMAILS=
