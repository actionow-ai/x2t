// X2T 数据模型 —— 对应设计文档 §5
// M1 实际用到：Influencer / Post / Security / PostTicker(可选)
// 其余表为后续里程碑（M3 分析、M5 账号）预建，schema 一次定齐。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  twitter
  reddit
  news
  substack
  youtube
  rss
  manual
}

enum AnalysisStatus {
  pending
  done
  failed
}

enum Stance {
  bullish
  bearish
  neutral
}

// ---------- 内容核心 ----------

model Influencer {
  id           String   @id @default(cuid())
  handle       String
  platform     Platform @default(twitter)
  displayName  String?
  avatarUrl    String?
  bio          String?
  sourceConfig Json // { connector: "rss", feedUrl, ... }
  active       Boolean  @default(true)
  // 抓取健康状态（连续失败时标记）
  lastFetchedAt DateTime?
  fetchError    String?
  createdAt    DateTime @default(now())

  posts   Post[]
  follows Follow[]

  @@unique([platform, handle])
}

model Post {
  id             String         @id @default(cuid())
  influencerId   String
  platformPostId String // 去重键：同 platform 内唯一
  url            String?
  contentText    String // 原文
  lang           String? // 原文语种代码 en/zh/ja…
  contentZh      String? // 中文版（原文为中文则=原文）
  contentEn      String? // 英文版（原文为英文则=原文）
  mediaJson      Json?
  postedAt       DateTime
  fetchedAt      DateTime       @default(now())
  rawJson        Json?
  analysisStatus AnalysisStatus @default(pending)
  analysisAttempts Int          @default(0) // 失败重试计数:达上限(ANALYZE_MAX_ATTEMPTS)后不再自动重试
  likeCount      Int            @default(0) // 赞计数(去规范化,供卡片直接读)
  dislikeCount   Int            @default(0) // 踩计数

  influencer Influencer    @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  analysis   PostAnalysis?
  tickers    PostTicker[]
  deliveries Delivery[]
  reactions  PostReaction[]

  @@unique([influencerId, platformPostId]) // 幂等去重
  @@index([postedAt]) // 全站最新流
  @@index([influencerId, postedAt]) // 首页按关注过滤 + detectFlips(同博主历史)
  @@index([analysisStatus, postedAt]) // analyzePending: where status=pending order postedAt(前缀也覆盖 status-only)
}

// 帖子赞/踩。voterKey = userId(登录)或匿名 cookie id;每 voter 每帖一票。计数去规范化到 Post。
model PostReaction {
  postId    String
  voterKey  String
  value     Int // 1=赞, -1=踩
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, voterKey])
  @@index([postId])
}

model PostAnalysis {
  id            String   @id @default(cuid())
  postId        String   @unique
  lang          String? // 分析/帖子原始语种
  summary       String // 中文
  summaryEn     String? // English
  keyPoints     Json // string[] 中文
  keyPointsEn   Json? // string[] English
  overallStance Stance
  confidence    Float?
  model         String?
  createdAt     DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Security {
  symbol    String  @id
  name      String?
  exchange  String?
  assetType String?
  sector    String?

  postTickers PostTicker[]
  dataCache   ExternalDataCache[]
}

model PostTicker {
  id          String  @id @default(cuid())
  postId      String
  symbol      String
  stance      Stance
  rationale   String? // 中文
  rationaleEn String? // English

  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  security Security @relation(fields: [symbol], references: [symbol])

  @@unique([postId, symbol])
  @@index([symbol])
}

model ExternalDataCache {
  id        String   @id @default(cuid())
  symbol    String
  dataType  String // quote | news | financials | analyst | ...
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime // TTL 控成本

  security Security @relation(fields: [symbol], references: [symbol])

  @@index([symbol, dataType])
  @@index([expiresAt])
}

// 每标的每日收盘价(来源 Stooq 免费历史)。供"博主立场→N 日前瞻收益"的历史胜率回算。
model PriceDaily {
  symbol String
  date   DateTime @db.Date
  close  Float

  @@id([symbol, date])
  @@index([symbol, date])
}

// ---------- 用户 · 订阅 · 推送 ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  createdAt    DateTime @default(now())
  tokenVersion Int      @default(0) // 会话版本:登出/泄露时 +1 使旧 cookie 失效
  digestOptIn  Boolean  @default(false) // 邮件每日摘要订阅(显式 opt-in,默认关)

  follows           Follow[]
  pushSubscriptions PushSubscription[]
  alertRules        AlertRule[]
}

// 可组合告警规则(借鉴 PanWatch notify_policy:用户自定义 AND/OR 条件,命中才推)。
model AlertRule {
  id          String    @id @default(cuid())
  userId      String
  symbol      String? // null = 任意标的
  minBull     Int       @default(0) // 看多博主数 ≥(0=不启用此条件)
  minBear     Int       @default(0) // 看空博主数 ≥
  onFlip      Boolean   @default(false) // 出现立场翻转
  combine     String    @default("or") // and | or:多个条件如何组合
  active      Boolean   @default(true)
  lastFiredAt DateTime? // 冷却:避免同一规则反复轰炸
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([symbol])
}

model Follow {
  userId       String
  influencerId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@id([userId, influencerId])
}

model PushSubscription {
  id           String   @id @default(cuid())
  endpoint     String   @unique
  keysJson     Json // { p256dh, auth }
  userId       String? // 可空 = 匿名也能订阅推送
  followFilter Json? // 匿名关注列表镜像
  createdAt    DateTime @default(now())

  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries Delivery[]
}

model Delivery {
  id                 String   @id @default(cuid())
  postId             String
  pushSubscriptionId String?
  channel            String // webpush | email
  status             String   @default("sent")
  sentAt             DateTime @default(now())

  post             Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  pushSubscription PushSubscription? @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)

  @@unique([postId, pushSubscriptionId, channel]) // 防重复推送
}

model MagicLink {
  token     String    @id
  email     String
  code      String? // 6 位邮箱验证码(OTP);按 (email, code) 校验
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, code])
}
